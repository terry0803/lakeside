data: {"answer": "This place is the Museum of Cyber Incidents, which displays real security breaches like Target, Marriott, MGM Resorts, and WannaCry. You can see threats such as Third-Party Compromise, Phone Social Engineering, POS Memory-Scraping Malware, Ransomware, and Exploited Unpatched Software. Controls visible here include Patch & Vulnerability Management and Vendor Risk Management.", "go": [], "followups": [{"text": "What should I do next?", "en": "What should I do next?", "zh": "接下來要去哪？"}, {"text": "How do we prevent Third-Party & Supply-Chain compromise?", "en": "How do we prevent Third-Party & Supply-Chain compromise?", "zh": "第三方與供應鏈入侵要怎麼防？"}], "trace": {"session": "offline", "lang": "en", "model": "qwen3.5:9b", "timings": {"route_s": 0.0, "tool_s": 0.01, "answer_s": 9.6, "total_s": 9.62}, "route": {"tool": "room_overview", "target": "", "how": "button"}, "link": {"query": "(current room)", "chosen": "museum_in", "how": "current room"}, "redirect": "", "queries": [{"purpose": "everything placed in this room", "cypher": "MATCH (r:Room {key:$k}) RETURN r {.key, .name_en, .name_zh, .it_en, .it_zh, .tour, .url, .url_index, .area, .kind, .story, .theme_en, .theme_zh, .lesson_en, .lesson_zh} AS r, [(r)-[:IN_AREA]->(a) | a {.key, .name_en, .name_zh}][0] AS area, [(r)-[:CLOSEUP_OF]->(p) | p {.key, .name_en, .name_zh, .it_en, .it_zh, .tour, .url, .url_index, .area, .kind, .story, .theme_en, .theme_zh, .lesson_en, .lesson_zh}][0] AS parent, [(s:System)-[:LOCATED_IN]->(r) | s {.key, .name_en, .name_zh, .desc_en, .desc_zh}] AS systems, [(t:Threat)-[:SHOWN_IN]->(r) | t {.key, .name_en, .name_zh, .desc_en, .desc_zh}] AS threats, [(c:Control)-[:SEEN_IN]->(r) | c {.key, .name_en, .name_zh, .desc_en, .desc_zh, .type}] AS controls, [(c:Concept)-[:TAUGHT_IN]->(r) | c {.key, .name_en, .name_zh, .desc_en, .desc_zh}] AS concepts, [(p:Procedure)-[:PRACTISED_IN]->(r) | p {.key, .name_en, .name_zh, .kind}] AS procedures, [(d:Department)-[:BASED_IN]->(r) | d {.key, .name_en, .name_zh, .desc_en, .desc_zh, .ext}] AS departments, [(cs:CaseStudy)-[:SHOWN_IN]->(r) | cs {.key, .name_en, .name_zh, .year}] AS cases, [(r)-[l:LINKS_TO]->(x) | x {.key, .name_en, .name_zh, .it_en, .it_zh, .tour, .url, .url_index, .area, .kind, .story, .theme_en, .theme_zh, .lesson_en, .lesson_zh, teleport: l.teleport}] AS exits, size([(f:Finding)-[:IN_ROOM]->(r) | f]) AS findings_here", "params": {"k": "museum_in"}, "rows": 1, "ms": 6.3}], "graph": {"nodes": [{"key": "museum_in", "label": "Room", "en": "Museum of Cyber Incidents", "zh": "資安事件博物館"}, {"key": "supply_chain", "label": "Threat", "en": "Third-Party & Supply-Chain Compromise", "zh": "第三方與供應鏈入侵"}, {"key": "vishing", "label": "Threat", "en": "Phone Social Engineering", "zh": "電話社交工程"}, {"key": "pos_malware", "label": "Threat", "en": "POS Memory-Scraping Malware", "zh": "POS 記憶體側錄惡意程式"}, {"key": "ransomware", "label": "Threat", "en": "Ransomware", "zh": "勒索軟體"}, {"key": "unpatched", "label": "Threat", "en": "Exploited Unpatched Software", "zh": "未修補漏洞被利用"}, {"key": "patch_management", "label": "Control", "en": "Patch & Vulnerability Management", "zh": "修補與弱點管理"}, {"key": "vendor_management", "label": "Control", "en": "Vendor Risk Management", "zh": "廠商風險管理"}, {"key": "c_supply_chain_risk", "label": "Concept", "en": "Supply-Chain Risk", "zh": "供應鏈風險"}], "edges": [{"a": "vendor_management", "t": "SEEN_IN", "b": "museum_in"}, {"a": "vendor_management", "t": "MITIGATES", "b": "supply_chain"}, {"a": "vishing", "t": "SHOWN_IN", "b": "museum_in"}, {"a": "ransomware", "t": "SHOWN_IN", "b": "museum_in"}, {"a": "pos_malware", "t": "SHOWN_IN", "b": "museum_in"}, {"a": "unpatched", "t": "SHOWN_IN", "b": "museum_in"}, {"a": "supply_chain", "t": "SHOWN_IN", "b": "museum_in"}, {"a": "c_supply_chain_risk", "t": "TAUGHT_IN", "b": "museum_in"}, {"a": "c_supply_chain_risk", "t": "RELATED_TO", "b": "supply_chain"}, {"a": "c_supply_chain_risk", "t": "RELATED_TO", "b": "vendor_management"}, {"a": "patch_management", "t": "SEEN_IN", "b": "museum_in"}, {"a": "patch_management", "t": "MITIGATES", "b": "ransomware"}, {"a": "patch_management", "t": "MITIGATES", "b": "unpatched"}]}, "tool_used": "room_overview", "facts": "Room: Museum of Cyber Incidents\nWhat it shows: Real incidents that changed security practice: Target, Marriott, MGM Resorts, WannaCry and more.\nKey lesson: Most famous breaches started with something basic: a vendor login, a missing patch, a phone call.\nThreats shown here: Third-Party & Supply-Chain Compromise, Phone Social Engineering, POS Memory-Scraping Malware, Ransomware, Exploited Unpatched Software\nControls you can see: Patch & Vulnerability Management, Vendor Risk Management\nConcepts: Supply-Chain Risk\nReal cases: Target Data Breach (2013), Marriott (Starwood) Guest Database Breach (disclosed 2018), SolarWinds Supply-Chain Attack (2020), Equifax Data Breach (2017), Colonial Pipeline Ransomware (2021), Log4Shell Vulnerability (2021), WannaCry Ransomware (2017), MGM Resorts Cyberattack (2023)\nExits: Market Square · Online Sales", "answer_stats": {"model": "qwen3.5:9b", "wall_s": 9.6, "load_s": 0.0, "prompt_tokens": 669, "prompt_s": 2.67, "gen_tokens": 80, "gen_s": 6.9, "tok_per_s": 11.6, "first_token_s": 2.7}}, "state": {}}

