data: {"type": "sections", "label": "Room", "title": {"en": "Museum of Cyber Incidents", "zh": "資安事件博物館"}, "subtitle": {"en": "Museum of Cyber Incidents", "zh": "資安事件博物館"}, "text": {"en": "Real incidents that changed security practice: Target, Marriott, MGM Resorts, WannaCry and more.", "zh": "真實發生過、改變資安做法的事件：Target、Marriott、MGM 渡假村、WannaCry 等。"}, "note": {"en": "Most famous breaches started with something basic: a vendor login, a missing patch, a phone call.", "zh": "很多有名的事件都從很基本的地方開始：廠商帳號、沒修補的漏洞、一通電話。"}, "badges": [], "sections": [{"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "supply_chain", "en": "Third-Party & Supply-Chain Compromise", "zh": "第三方與供應鏈入侵"}, {"key": "vishing", "en": "Phone Social Engineering", "zh": "電話社交工程"}, {"key": "pos_malware", "en": "POS Memory-Scraping Malware", "zh": "POS 記憶體側錄惡意程式"}, {"key": "ransomware", "en": "Ransomware", "zh": "勒索軟體"}, {"key": "unpatched", "en": "Exploited Unpatched Software", "zh": "未修補漏洞被利用"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "patch_management", "en": "Patch & Vulnerability Management", "zh": "修補與弱點管理"}, {"key": "vendor_management", "en": "Vendor Risk Management", "zh": "廠商風險管理"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_supply_chain_risk", "en": "Supply-Chain Risk", "zh": "供應鏈風險"}]}, {"h_en": "Real cases", "h_zh": "真實案例", "kind": "entities", "items": [{"key": "case_target", "en": "Target Data Breach (2013)", "zh": "Target 資料外洩事件（2013）"}, {"key": "case_marriott", "en": "Marriott (Starwood) Guest Database Breach (disclosed 2018)", "zh": "Marriott（喜達屋）訂房資料庫外洩（2018 年揭露）"}, {"key": "case_solarwinds", "en": "SolarWinds Supply-Chain Attack (2020)", "zh": "SolarWinds 供應鏈攻擊（2020）"}, {"key": "case_equifax", "en": "Equifax Data Breach (2017)", "zh": "Equifax 資料外洩（2017）"}, {"key": "case_colonial", "en": "Colonial Pipeline Ransomware (2021)", "zh": "Colonial Pipeline 勒索軟體（2021）"}, {"key": "case_log4shell", "en": "Log4Shell 