data: {"type": "sections", "label": "Room", "title": {"en": "Pool · Data Lake", "zh": "泳池・資料湖"}, "subtitle": {"en": "Pool", "zh": "泳池"}, "text": {"en": "Raw data from many systems pools here before analysts turn it into reports.", "zh": "各系統的原始資料匯進這裡，再由分析師整理成報表。"}, "note": {"en": "A data lake still needs classification and access control, or it turns into a data swamp.", "zh": "資料湖也要分級和權限控管，不然會變成資料沼澤。"}, "badges": [{"en": "Weaknesses to find here: 1", "zh": "這裡有 1 個漏洞待找"}], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "data_lake", "en": "Data Lake", "zh": "資料湖"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "misconfiguration", "en": "Misconfiguration & Excessive Access", "zh": "設定錯誤與權限過大"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "data_classification", "en": "Data Classification & Handling", "zh": "資料分級與處理規則"}, {"key": "data_masking", "en": "Data Masking", "zh": "資料遮蔽"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_data_lifecycle", "en": "Data Lifecycle", "zh": "資料生命週期"}, {"key": "c_warehouse_lake", "en": "Data Warehouse vs Data Lake", "zh": "資料倉儲與資料湖"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "pier", "en": "Pier · Deliveries & Vendors", "zh": "會館碼頭・進貨與廠商", "base_en": "Clubhouse Pier", "base_zh": "會館碼頭", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=20", "tour": "A"}, {"key": "villa_out", "en": "Lake Villas · Smart Rooms", "zh": "湖畔別墅・智慧客房", "base_en": "Lake Villas", "base_zh": "湖畔別墅", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=16", "tour": "B"}, {"key": "greenhouse_in", "en": "Greenhouse · Test Environment", "zh": "溫室・測試環境", "base_en": "Greenhouse", "base_zh": "溫室", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=15", "tour": "B"}, {"key": "lawn", "en": "Lawn · Assembly Point & Continuity", "zh":