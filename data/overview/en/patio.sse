data: {"answer": "This is the Guest Arrival & Wi-Fi room (shown as 'Lakeside Patio'). Guests check in on the Property Management System (PMS) and look for the Wi-Fi sign here. You can see controls like Network Segmentation and Privacy Notice & Consent, which address threats such as Rogue Wi-Fi and Shoulder Surfing.", "go": [{"key": "hall", "en": "Restaurant POS", "zh": "餐廳收銀系統", "base_en": "Restaurant", "base_zh": "餐廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=3", "tour": "A", "why_en": "Next in the story", "why_zh": "故事的下一站"}], "followups": [{"text": "What does the Wi-Fi (Guest & Staff) do?", "en": "What does the Wi-Fi (Guest & Staff) do?", "zh": "無線網路（訪客與員工）是做什麼的？"}, {"text": "How do we prevent shoulder surfing & screen exposure?", "en": "How do we prevent shoulder surfing & screen exposure?", "zh": "偷窺與螢幕外露要怎麼防？"}, {"text": "What should I do next?", "en": "What should I do next?", "zh": "接下來要去哪？"}], "trace": {"session": "offline", "lang": "en", "model": "qwen3.5:9b", "timings": {"route_s": 0.0, "tool_s": 0.01, "answer_s": 13.07, "total_s": 13.09}, "route": {"tool": "room_overview", "target": "", "how": "button"}, "link": {"query": "(current room)", "chosen": "patio", "how": "current room"}, "redirect": "", "queries": [{"purpose": "everything placed in this room", "cypher": "MATCH (r:Room {key:$k}) RETURN r {.key, .name_en, .name_zh, .it_en, .it_zh, .tour, .url, .url_index, .area, .kind, .story, .theme_en, .theme_zh, .lesson_en, .lesson_zh} AS r, [(r)-[:IN_AREA]->(a) | a {.key, .name_en, .name_zh}][0] AS area, [(r)-[:CLOSEUP_OF]->(p) | p {.key, .name_en, .name_zh, .it_en, .it_zh, .tour, .url, .url_index, .area, .kind, .story, .theme_en, .theme_zh, .lesson_en, .lesson_zh}][0] AS parent, [(s:System)-[:LOCATED_IN]->(r) | s {.key, .name_en, .name_zh, .desc_en, .desc_zh}] AS systems, [(t:Threat)-[:SHOWN_IN]->(r) | t {.key, .name_en, .name_zh, .desc_en, .desc_zh}] AS threats, [(c:Control)-[:SEEN_IN]->(r) | c {.key, .name_en, .name_zh, .desc_en, .desc_zh, .type}] AS controls, [(c:Concept)-[:TAUGHT_IN]->(r) | c {.key, .name_en, .name_zh, .desc_en, .desc_zh}] AS concepts, [(p:Procedure)-[:PRACTISED_IN]->(r) | p {.key, .name_en, .name_zh, .kind}] AS procedures, [(d:Department)-[:BASED_IN]->(r) | d {.key, .name_en, .name_zh, .desc_en, .desc_zh, .ext}] AS departments, [(cs:CaseStudy)-[:SHOWN_IN]->(r) | cs {.key, .name_en, .name_zh, .year}] AS cases, [(r)-[l:LINKS_TO]->(x) | x {.key, .name_en, .name_zh, .it_en, .it_zh, .tour, .url, .url_index, .area, .kind, .story, .theme_en, .theme_zh, .lesson_en, .lesson_zh, teleport: l.teleport}] AS exits, size([(f:Finding)-[:IN_ROOM]->(r) | f]) AS findings_here", "params": {"k": "patio"}, "rows": 1, "ms": 6.7}], "graph": {"nodes": [{"key": "patio", "label": "Room", "en": "Lakeside Patio", "zh": "湖畔露台"}, {"key": "wifi", "label": "System", "en": "Wi-Fi (Guest & Staff)", "zh": "無線網路（訪客與員工）"}, {"key": "crm", "label": "System", "en": "CRM & Loyalty", "zh": "CRM 與會員系統"}, {"key": "pms", "label": "System", "en": "Property Management System (PMS)", "zh": "飯店管理系統（PMS）"}, {"key": "shoulder_surfing", "label": "Threat", "en": "Shoulder Surfing & Screen Exposure", "zh": "偷窺與螢幕外露"}, {"key": "evil_twin", "label": "Threat", "en": "Rogue Wi-Fi & Eavesdropping", "zh": "假冒熱點與竊聽"}, {"key": "segmentation", "label": "Control", "en": "Network Segmentation", "zh": "網段隔離"}, {"key": "privacy_notice_consent", "label": "Control", "en": "Privacy Notice & Consent", "zh": "個資告知與同意"}, {"key": "c_personal_data", "label": "Concept", "en": "Personal Data", "zh": "個人資料"}], "edges": [{"a": "privacy_notice_consent", "t": "SEEN_IN", "b": "patio"}, {"a": "pms", "t": "SENDS_TO", "b": "crm"}, {"a": "pms", "t": "LOCATED_IN", "b": "patio"}, {"a": "crm", "t": "LOCATED_IN", "b": "patio"}, {"a": "wifi", "t": "LOCATED_IN", "b": "patio"}, {"a": "evil_twin", "t": "TARGETS", "b": "wifi"}, {"a": "evil_twin", "t": "SHOWN_IN", "b": "patio"}, {"a": "shoulder_surfing", "t": "TARGETS", "b": "crm"}, {"a": "shoulder_surfing", "t": "SHOWN_IN", "b": "patio"}, {"a": "c_personal_data", "t": "TAUGHT_IN", "b": "patio"}, {"a": "segmentation", "t": "SEEN_IN", "b": "patio"}, {"a": "segmentation", "t": "PROTECTS", "b": "wifi"}]}, "tool_used": "room_overview", "facts": "Room: Guest Arrival & Wi-Fi (called 'Lakeside Patio' in the tour)\nWhat it shows: Guests arrive here, check in on the PMS and look for the Wi-Fi sign to get online.\nKey lesson: Keep guest and staff networks apart, and tell guests how their data is used when you collect it.\nDepartment based here: Front Office (ext. 1200)\nSystems here: Wi-Fi (Guest & Staff), CRM & Loyalty, Property Management System (PMS)\nThreats shown here: Shoulder Surfing & Screen Exposure, Rogue Wi-Fi & Eavesdropping\nControls you can see: Network Segmentation, Privacy Notice & Consent\nConcepts: Personal Data\nExits: Pier · Deliveries & Vendors (called 'Clubhouse Pier' in the tour), Restaurant POS, Pool · Data Lake, Lawn · Assembly Point & Continuity (called 'Lakeside Lawn' in the tour), Patio Close-up · Wi-Fi Sign (called 'Patio · Up Close' in the tour)", "answer_stats": {"model": "qwen3.5:9b", "wall_s": 13.07, "load_s": 0.0, "prompt_tokens": 662, "prompt_s": 2.86, "gen_tokens": 67, "gen_s": 5.64, "tok_per_s": 11.9, "first_token_s": 7.43}}, "state": {}}

