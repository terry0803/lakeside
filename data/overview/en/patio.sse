data: {"type": "sections", "label": "Room", "title": {"en": "Guest Arrival & Wi-Fi", "zh": "客人報到與無線網路"}, "subtitle": {"en": "Lakeside Patio", "zh": "湖畔露台"}, "text": {"en": "Guests arrive here, check in on the PMS and look for the Wi-Fi sign to get online.", "zh": "客人在這裡抵達，用 PMS 辦報到，再看 Wi-Fi 牌子連上網路。"}, "note": {"en": "Keep guest and staff networks apart, and tell guests how their data is used when you collect it.", "zh": "訪客和員工網路要隔開；收集客人資料時要先告知用途。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "wifi", "en": "Wi-Fi (Guest & Staff)", "zh": "無線網路（訪客與員工）"}, {"key": "crm", "en": "CRM & Loyalty", "zh": "CRM 與會員系統"}, {"key": "pms", "en": "Property Management System (PMS)", "zh": "飯店管理系統（PMS）"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "shoulder_surfing", "en": "Shoulder Surfing & Screen Exposure", "zh": "偷窺與螢幕外露"}, {"key": "evil_twin", "en": "Rogue Wi-Fi & Eavesdropping", "zh": "假冒熱點與竊聽"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "segmentation", "en": "Network Segmentation", "zh": "網段隔離"}, {"key": "privacy_notice_consent", "en": "Privacy Notice & Consent", "zh": "個資告知與同意"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_personal_data", "en": "Personal Data", "zh": "個人資料"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "pier", "en": "Pier · Deliveries & Vendors", "zh": "會館碼頭・進貨與廠商", "base_en": "Clubhouse Pier", "base_zh": "會館碼頭", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=20", "tour": "A"}, {"key": "hall", "en": "Restaurant POS", "zh": "餐廳收銀系統", "base_en": "Restaurant", "base_zh": "餐廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=3", "tour": "A"}, {"key": "pool", "en": "Pool · Data Lake", "zh": "泳池・資料湖", "base_en": "Pool", "base_zh": "泳池", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=14", "tour": "B"}, {"key": "lawn", "en": "Lawn · Assembly Point & Continuity", "zh": "湖邊草地・集合點與營運持續", "base_en": "Lakeside Lawn", "base_zh": "湖邊草地", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=19", "tour": "A"}, {"key": "patio_near", "en": "Patio Close-up · Wi-Fi Sign", "zh": "露台近看・Wi-Fi 說明牌", "base_en": "Patio · Up Close", "base_zh": "露台近看", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=21", "tour": "A"}]}]}

