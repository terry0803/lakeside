data: {"type": "sections", "label": "Room", "title": {"en": "Lighthouse · Security Operations Center", "zh": "燈塔・資安監控中心"}, "subtitle": {"en": "Lighthouse", "zh": "燈塔"}, "text": {"en": "The SOC watches logs from every system around the clock; the keeper's log is the security log.", "zh": "資安監控中心全天候看著各系統的日誌；守燈人日誌就是資安日誌。"}, "note": {"en": "Finding unusual patterns in logs is data mining at work: anomaly detection.", "zh": "從日誌裡找出不尋常的模式，就是資料探勘的異常偵測。"}, "badges": [{"en": "Weaknesses to find here: 1", "zh": "這裡藏著 1 個漏洞"}], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "edr", "en": "Endpoint Protection (EDR)", "zh": "端點防護（EDR）"}, {"key": "siem", "en": "SIEM & Log Management", "zh": "SIEM 與日誌管理"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "ransomware", "en": "Ransomware", "zh": "勒索軟體"}, {"key": "credential_stuffing", "en": "Password Guessing & Credential Stuffing", "zh": "密碼猜測與撞庫"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "incident_response", "en": "Incident Response Plan & SOC", "zh": "事件應變計畫與資安監控中心"}, {"key": "logging_monitoring", "en": "Logging & Monitoring (SIEM)", "zh": "日誌與監控（SIEM）"}, {"key": "edr_antimalware", "en": "Endpoint Protection (EDR)", "zh": "端點防護（EDR）"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_anomaly_detection", "en": "Anomaly Detection", "zh": "異常偵測"}, {"key": "c_risk", "en": "Risk = Likelihood × Impact", "zh": "風險＝可能性×衝擊"}, {"key": "c_soc_siem", "en": "SOC & SIEM", "zh": "資安監控中心與 SIEM"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_ransomware", "en": "Ransomware or encrypted files", "zh": "勒索軟體或檔案被加密"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "rowboat", "en": "On the Lake · Offsite Backup", "zh": "湖面上的小船・異地備份", "base_en": "On the Lake", "base_zh": "湖面上的小船", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=10", "