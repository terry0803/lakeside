data: {"type": "sections", "label": "Room", "title": {"en": "Steamer Deck · Working on the Move", "zh": "蒸汽船甲板・行動辦公"}, "subtitle": {"en": "Steamer Deck", "zh": "蒸汽船甲板"}, "text": {"en": "Staff work from laptops and phones on the move and connect back through the VPN.", "zh": "員工在移動中用筆電和手機工作，透過 VPN 連回公司。"}, "note": {"en": "Use the VPN, lock your device and report a lost one at once.", "zh": "用 VPN、裝置要上鎖、掉了馬上通報。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "mdm", "en": "Mobile Device Management (MDM)", "zh": "行動裝置管理（MDM）"}, {"key": "endpoints", "en": "Staff Laptops, PCs & Phones", "zh": "員工筆電、電腦與手機"}, {"key": "vpn", "en": "VPN Gateway", "zh": "VPN 閘道"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "device_loss", "en": "Lost or Stolen Device", "zh": "裝置遺失或遭竊"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "vendor_remote_access", "en": "Time-Limited Vendor Access", "zh": "廠商限時遠端存取"}, {"key": "vpn_remote", "en": "VPN for Remote Access", "zh": "遠端連線使用 VPN"}, {"key": "mdm_wipe", "en": "Device Management & Remote Wipe", "zh": "裝置管理與遠端抹除"}, {"key": "encryption", "en": "Encryption (Disk, Data & TLS)", "zh": "加密（磁碟、資料、傳輸）"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_encryption_hashing", "en": "Encryption vs Hashing", "zh": "加密與雜湊"}, {"key": "c_zero_trust", "en": "Zero Trust", "zh": "零信任"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_vendor_access", "en": "A vendor needs remote access", "zh": "廠商要遠端連線"}, {"key": "proc_lost_device", "en": "Lost or stolen laptop or phone", "zh": "筆電或手機遺失"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "breakwater", "en": "Breakwater · Network Perimeter", "zh": "防波堤・網路邊界", "base_en": "Breakwater", "base_zh": "防波堤", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=4", "tour": "B"}, {"key": "pier", "en":