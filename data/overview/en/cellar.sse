data: {"type": "sections", "label": "Room", "title": {"en": "Server Room (Restricted)", "zh": "機房（限制進入）"}, "subtitle": {"en": "Server Room", "zh": "機房"}, "text": {"en": "Servers, storage, network gear, the UPS and the on-site backup sit behind a locked door; entering without authorization sets off the alarm (bad ending).", "zh": "伺服器、儲存設備、網路設備、不斷電系統和本地備份都在上鎖的門後；沒授權闖進來會觸發警報（壞結局）。"}, "note": {"en": "Only authorized people enter the server room, and every entry is logged.", "zh": "只有授權的人能進機房，每次進出都有紀錄。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "network", "en": "Network Switches & VLANs", "zh": "網路交換器與網段（VLAN）"}, {"key": "servers", "en": "Servers & Storage", "zh": "伺服器與儲存設備"}, {"key": "backup", "en": "Backup System", "zh": "備份系統"}, {"key": "firewall", "en": "Firewall", "zh": "防火牆"}, {"key": "access_control", "en": "Badge Access Control", "zh": "門禁系統"}, {"key": "power", "en": "UPS & Backup Generator", "zh": "不斷電系統與發電機"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "environmental", "en": "Power Outage, Fire & Flood", "zh": "停電、火災與淹水"}, {"key": "tailgating", "en": "Tailgating & Unauthorised Entry", "zh": "尾隨與未經授權進入"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "backup_321", "en": "3-2-1 Backups with an Offline Copy", "zh": "3-2-1 備份與離線副本"}, {"key": "environmental_protection", "en": "UPS, Generator & Fire Suppression", "zh": "不斷電、發電機與滅火設備"}, {"key": "physical_access", "en": "Physical Access Control", "zh": "實體門禁"}, {"key": "firewall_ids", "en": "Firewall & Intrusion Detection", "zh": "防火牆與入侵偵測"}, {"key": "segmentation", "en": "Network Segmentation", "zh": "網段隔離"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "corridor", "en": "Staff Corridor & Physical Security", "zh": "員工走廊與實體安全", "base_en": "Corridor", "base_zh": "走廊", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=5", "tour": "A"}]}]}

