data: {"type": "sections", "label": "Room", "title": {"en": "Plaza · Signage & Public Kiosk", "zh": "湖邊廣場・數位看板與資訊站"}, "subtitle": {"en": "Lakeside Plaza at Night", "zh": "夜晚的湖邊廣場"}, "text": {"en": "Digital signs and a public kiosk show event information; cameras watch the plaza. After 21:00 the bridge to the Lake Pavilion is a staff gate: its code is the SOC's extension, the number you call to report phishing.", "zh": "數位看板和公共資訊站顯示活動資訊，廣場有監視器。晚上九點以後，往湖心館的橋頭是員工通道，密碼是資安監控中心的分機，也就是回報釣魚要打的號碼。"}, "note": {"en": "Lock down public screens and tell people where cameras record them.", "zh": "公共螢幕要鎖好；有監視器的地方要告知。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "signage", "en": "Digital Signage", "zh": "數位看板"}, {"key": "kiosk", "en": "Public Information Kiosk", "zh": "公共資訊站"}, {"key": "event_iot", "en": "Event Lighting & Fireworks Controllers", "zh": "活動燈光與煙火控制器"}, {"key": "cctv", "en": "CCTV & Video Management", "zh": "監視器與錄影系統"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "signage_hijack", "en": "Signage & Kiosk Tampering", "zh": "看板與資訊站遭竄改"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "kiosk_lockdown", "en": "Kiosk Lockdown & Signage Access Control", "zh": "資訊站鎖定與看板權限"}, {"key": "secure_config", "en": "Secure Configuration (No Default Passwords)", "zh": "安全組態（不用預設密碼）"}, {"key": "privacy_notice_consent", "en": "Privacy Notice & Consent", "zh": "個資告知與同意"}, {"key": "cctv_monitoring", "en": "CCTV Monitoring", "zh": "監視器監控"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "pav_lobby", "en": "Lobby · BI Dashboards", "zh": "湖心館大廳・BI 儀表板", "base_en": "Lake Pavilion Lobby", "base_zh": "湖心館大廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=14", "tour": "A"}]}]}

