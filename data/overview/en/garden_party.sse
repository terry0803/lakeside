data: {"type": "sections", "label": "Room", "title": {"en": "Garden Party · IoT & OT", "zh": "花園派對・物聯網與 OT"}, "subtitle": {"en": "Garden Party", "zh": "花園派對"}, "text": {"en": "Smart lights and the fireworks controller run on the network, and staff phones are at the party too.", "zh": "智慧燈光和煙火控制器都接在網路上，員工的手機也在現場。"}, "note": {"en": "Change default passwords and keep IoT devices on their own network.", "zh": "物聯網設備要改掉預設密碼，放在獨立的網段。"}, "badges": [{"en": "Weaknesses to find here: 1", "zh": "這裡藏著 1 個漏洞"}], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "event_iot", "en": "Event Lighting & Fireworks Controllers", "zh": "活動燈光與煙火控制器"}, {"key": "mdm", "en": "Mobile Device Management (MDM)", "zh": "行動裝置管理（MDM）"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "iot_default", "en": "Insecure IoT Devices", "zh": "不安全的物聯網設備"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "secure_config", "en": "Secure Configuration (No Default Passwords)", "zh": "安全組態（不用預設密碼）"}, {"key": "mdm_wipe", "en": "Device Management & Remote Wipe", "zh": "裝置管理與遠端抹除"}, {"key": "segmentation", "en": "Network Segmentation", "zh": "網段隔離"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_it_ot", "en": "IT, OT & IoT", "zh": "IT、OT 與物聯網"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "plaza_fw", "en": "Plaza · Signage & Public Kiosk", "zh": "湖邊廣場・數位看板與資訊站", "base_en": "Lakeside Plaza at Night", "base_zh": "夜晚的湖邊廣場", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=13", "tour": "A"}]}]}

