data: {"type": "sections", "label": "Room", "title": {"en": "Harbour Square · Suppliers", "zh": "港口廣場・供應商"}, "subtitle": {"en": "Harbour Square", "zh": "港口廣場"}, "text": {"en": "The old town's shops are the resort's suppliers, and each one connects to the resort in its own way.", "zh": "老城的店家都是渡假村的供應商，各自用不同方式跟渡假村連線。"}, "note": {"en": "Your security is only as strong as your weakest supplier.", "zh": "你的資安強度，取決於最弱的那個供應商。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "supplier_portal", "en": "Supplier Portal", "zh": "供應商入口網站"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "supply_chain", "en": "Third-Party & Supply-Chain Compromise", "zh": "第三方與供應鏈入侵"}, {"key": "bec", "en": "Business Email Compromise", "zh": "商務郵件詐騙"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "vendor_management", "en": "Vendor Risk Management", "zh": "廠商風險管理"}, {"key": "payment_callback", "en": "Payment Change Call-Back", "zh": "匯款變更回撥確認"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_supply_chain_risk", "en": "Supply-Chain Risk", "zh": "供應鏈風險"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_bank_change", "en": "A supplier asks to change their bank details", "zh": "供應商要求變更匯款帳戶"}, {"key": "proc_vendor_access", "en": "A vendor needs remote access", "zh": "廠商要遠端連線"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "breakwater", "en": "Breakwater · Network Perimeter", "zh": "防波堤・網路邊界", "base_en": "Breakwater", "base_zh": "防波堤", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=4", "tour": "B"}, {"key": "church_in", "en": "Privacy Chapel", "zh": "隱私小教堂", "base_en": "Lakeside Chapel", "base_zh": "湖畔教堂", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=3", "tour": "B"}, {"key": "market_square", "en": "Market Square · Online Sales", "zh":