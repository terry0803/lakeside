data: {"type": "sections", "label": "Room", "title": {"en": "Lobby · BI Dashboards", "zh": "湖心館大廳・BI 儀表板"}, "subtitle": {"en": "Lake Pavilion Lobby", "zh": "湖心館大廳"}, "text": {"en": "Dashboards turn POS and booking data into KPIs such as occupancy, ADR and RevPAR.", "zh": "儀表板把 POS 和訂房資料變成住房率、平均房價、每間可售房收入這些指標。"}, "note": {"en": "Data becomes information and knowledge only when it is cleaned, combined and shown to the right people.", "zh": "資料要整理、整合、給對的人看，才會變成資訊和知識。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "bi", "en": "BI & Data Warehouse", "zh": "BI 與資料倉儲"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_warehouse_lake", "en": "Data Warehouse vs Data Lake", "zh": "資料倉儲與資料湖"}, {"key": "c_bi_kpi", "en": "BI & Hotel KPIs", "zh": "商業智慧與飯店指標"}, {"key": "c_dikw", "en": "DIKW Pyramid", "zh": "DIKW 金字塔（資料、資訊、知識、智慧）"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "plaza_fw", "en": "Plaza · Signage & Public Kiosk", "zh": "湖邊廣場・數位看板與資訊站", "base_en": "Lakeside Plaza at Night", "base_zh": "夜晚的湖邊廣場", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=13", "tour": "A"}, {"key": "pav_lobby_near", "en": "Lobby Close-up · KPI Wall", "zh": "大廳水池對面・KPI 牆", "base_en": "Lobby · Across the Pool", "base_zh": "大廳水池對面", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=28", "tour": "A"}, {"key": "pav_theater", "en": "Theater · Awards Night", "zh": "湖心館劇場・頒獎晚會", "base_en": "Lake Pavilion Theater", "base_zh": "湖心館劇場", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=15", "tour": "A"}]}]}

