data: {"type": "sections", "label": "Room", "title": {"en": "Bar Inventory & ERP", "zh": "酒吧庫存與 ERP"}, "subtitle": {"en": "Bar", "zh": "酒吧"}, "text": {"en": "Every bottle is scanned into the ERP; POS sales reduce stock and low stock creates purchase orders to suppliers.", "zh": "每瓶酒都掃條碼進 ERP；POS 賣出就扣庫存，庫存不夠就產生採購單給供應商。"}, "note": {"en": "Audit trails and segregation of duties stop one person from both counting and adjusting stock.", "zh": "操作紀錄和職務分離，讓同一個人不能又盤點又改庫存。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "pos", "en": "Point of Sale (POS)", "zh": "餐飲收銀系統（POS）"}, {"key": "erp", "en": "ERP · Inventory & Purchasing", "zh": "ERP 庫存與採購"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "insider_fraud", "en": "Insider Misuse & Fraud", "zh": "內部人員濫用與舞弊"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "sod", "en": "Segregation of Duties", "zh": "職務分離"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_erp", "en": "Enterprise Resource Planning (ERP)", "zh": "企業資源規劃（ERP）"}, {"key": "c_audit_trail", "en": "Audit Trail", "zh": "稽核軌跡"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "corridor", "en": "Staff Corridor & Physical Security", "zh": "員工走廊與實體安全", "base_en": "Corridor", "base_zh": "走廊", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=5", "tour": "A"}, {"key": "bar_near", "en": "Bar Close-up · Scanner & Stock Screen", "zh": "酒吧近看・掃描器與庫存畫面", "base_en": "Bar · Up Close", "base_zh": "酒吧近看", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=24", "tour": "A"}, {"key": "hall", "en": "Restaurant POS", "zh": "餐廳收銀系統", "base_en": "Restaurant", "base_zh": "餐廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=3", "tour": "A"}]}]}

