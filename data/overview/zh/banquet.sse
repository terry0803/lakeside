data: {"type": "sections", "label": "Room", "title": {"en": "Banquet Hall · Events & CRM", "zh": "宴會廳・活動與 CRM"}, "subtitle": {"en": "Banquet Hall", "zh": "宴會廳"}, "text": {"en": "Event registrations feed the CRM; marketing may use guests' data only for what they agreed to.", "zh": "活動報名資料進到 CRM；行銷只能在客人同意的範圍內使用。"}, "note": {"en": "Collect only what you need and stop marketing when a guest says no.", "zh": "只收需要的資料，客人說不要行銷就要停。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "crm", "en": "CRM & Loyalty", "zh": "CRM 與會員系統"}, {"key": "event_system", "en": "Event Registration & Check-in", "zh": "活動報名報到系統"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "misdelivery", "en": "Data Sent to the Wrong Person", "zh": "資料寄錯人"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "privacy_notice_consent", "en": "Privacy Notice & Consent", "zh": "個資告知與同意"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_crm", "en": "Customer Relationship Management (CRM)", "zh": "顧客關係管理（CRM）"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_data_misdelivery", "en": "Personal data sent to the wrong person", "zh": "個資寄錯人"}, {"key": "proc_guest_request", "en": "A guest asks to see, correct or delete their data", "zh": "客人要求查詢、更正或刪除個資"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "play", "en": "Security Awareness Training Room", "zh": "資安訓練室", "base_en": "Training Room", "base_zh": "資安訓練室", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=7", "tour": "A"}, {"key": "banquet_near", "en": "Stage Close-up · Award Programme", "zh": "舞台近看・頒獎流程", "base_en": "Stage · Up Close", "base_zh": "舞台近看", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=26", "tour": "A"}, {"key": "banquet_tv", "en": "Banquet TV Close-up · CRM Screen", "zh": "宴會廳電視近看・CRM 畫面",