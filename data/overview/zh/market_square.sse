data: {"type": "sections", "label": "Room", "title": {"en": "Market Square · Online Sales", "zh": "市集廣場・網路銷售"}, "subtitle": {"en": "Market Square", "zh": "市集廣場"}, "text": {"en": "The resort sells rooms and souvenirs online through the booking engine and web shop, and a payment gateway handles payments.", "zh": "渡假村在網路上賣房間和紀念品，付款交給金流閘道。"}, "note": {"en": "Protect the payment page and the website from skimming and attacks.", "zh": "付款頁和網站要防側錄和攻擊。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "web_shop", "en": "Online Shop", "zh": "線上商店"}, {"key": "channel_manager", "en": "Channel Manager", "zh": "通路管理系統"}, {"key": "payment_gateway", "en": "Payment Gateway", "zh": "金流閘道"}, {"key": "booking_engine", "en": "Online Booking Engine", "zh": "線上訂房系統"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "ddos", "en": "DDoS on Online Services", "zh": "分散式阻斷服務攻擊"}, {"key": "web_skimming", "en": "Web Skimming (Magecart)", "zh": "網頁側錄（Magecart）"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "payment_page_monitoring", "en": "Payment Page Script Monitoring", "zh": "付款頁面腳本監控"}, {"key": "encryption", "en": "Encryption (Disk, Data & TLS)", "zh": "加密（磁碟、資料、傳輸）"}, {"key": "waf_ddos", "en": "Web Application Firewall & DDoS Protection", "zh": "網站應用防火牆與 DDoS 防護"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_tokenization", "en": "Tokenization", "zh": "代碼化"}, {"key": "c_pci_scope", "en": "Cardholder Data Environment (PCI scope)", "zh": "持卡人資料環境（PCI 範圍）"}, {"key": "c_shared_responsibility", "en": "Shared Responsibility (Cloud & SaaS)", "zh": "共同責任（雲端與 SaaS）"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "museum_in", "en": "Museum of Cyber Incidents", "zh": "資安事件博物館", "base_en": "Museum of Cyber Incidents", "base_zh": "資安事件博物館", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=6", "tour": "B"}, 