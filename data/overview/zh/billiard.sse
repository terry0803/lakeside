data: {"type": "sections", "label": "Room", "title": {"en": "IT Help Desk", "zh": "資訊服務台"}, "subtitle": {"en": "IT Help Desk", "zh": "資訊服務台"}, "text": {"en": "The help desk handles tickets, account requests and changes, and keeps the asset inventory (CMDB).", "zh": "服務台處理報修單、帳號申請和變更，也管資產清冊（CMDB）。"}, "note": {"en": "Access is approved by job role, and password resets need an identity check.", "zh": "權限照職務核准；重設密碼前一定要核對身分。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "cmdb", "en": "Asset Inventory (CMDB)", "zh": "資產清冊（CMDB）"}, {"key": "iam", "en": "Directory & Single Sign-On (IAM)", "zh": "帳號目錄與單一登入（IAM）"}, {"key": "itsm", "en": "IT Service Desk (ITSM)", "zh": "IT 服務台系統（ITSM）"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "vishing", "en": "Phone Social Engineering", "zh": "電話社交工程"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "asset_inventory", "en": "Asset Inventory (CMDB)", "zh": "資產清冊（CMDB）"}, {"key": "least_privilege", "en": "Least Privilege & Role-Based Access", "zh": "最小權限與角色權限"}, {"key": "change_management", "en": "Change Management", "zh": "變更管理"}, {"key": "caller_verification", "en": "Caller Identity Verification", "zh": "來電身分核實"}, {"key": "access_review", "en": "Joiner-Mover-Leaver & Access Reviews", "zh": "到職異動離職與權限審查"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_itsm", "en": "ITIL & IT Service Management", "zh": "ITIL 與 IT 服務管理"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_password_reset", "en": "Password or MFA reset", "zh": "密碼或驗證重設"}, {"key": "proc_change", "en": "Making a change to a system", "zh": "系統變更"}, {"key": "proc_leaver", "en": "Employee leaving or changing role", "zh": "員工離職或調職"}, {"key": "proc_new_hire", "en": "New employee needs access", "zh": "新進人員開帳號"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "play", "en": "Security Awareness Training Room", "zh": "資安訓練室", "base_en": "Training Room", "base_zh": "資安訓練室", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=7", "tour": "A"}, {"key": "billiard_near", "en": "Help Desk Close-up · Ticket Board", "zh": "服務台近看・工單看板", "base_en": "IT Help Desk · Up Close", "base_zh": "服務台近看", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=25", "tour": "A"}, {"key": "corridor", "en": "Staff Corridor & Physical Security", "zh": "員工走廊與實體安全", "base_en": "Corridor", "base_zh": "走廊", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=5", "tour": "A"}]}]}

