data: {"type": "sections", "label": "Room", "title": {"en": "Privacy Chapel", "zh": "隱私小教堂"}, "subtitle": {"en": "Lakeside Chapel", "zh": "湖畔教堂"}, "text": {"en": "The stained glass shows the principles of personal data protection.", "zh": "彩繪玻璃畫的是個資保護的原則。"}, "note": {"en": "Use personal data only for its purpose, keep it accurate and safe, and delete it on time.", "zh": "個資只用在當初的目的、保持正確、保管好、時間到就刪。"}, "badges": [], "sections": [{"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "data_classification", "en": "Data Classification & Handling", "zh": "資料分級與處理規則"}, {"key": "retention_deletion", "en": "Data Minimization & Retention Schedule", "zh": "資料最小化與保存期限"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_data_lifecycle", "en": "Data Lifecycle", "zh": "資料生命週期"}, {"key": "c_privacy_principles", "en": "Privacy Principles", "zh": "個資保護原則"}, {"key": "c_personal_data", "en": "Personal Data", "zh": "個人資料"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_guest_request", "en": "A guest asks to see, correct or delete their data", "zh": "客人要求查詢、更正或刪除個資"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "town_square", "en": "Harbour Square · Suppliers", "zh": "港口廣場・供應商", "base_en": "Harbour Square", "base_zh": "港口廣場", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=1", "tour": "B"}, {"key": "church_near", "en": "Chapel Close-up · Privacy Principles", "zh": "教堂近看・個資原則", "base_en": "Chapel · Up Close", "base_zh": "教堂近看", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=12", "tour": "B"}]}]}

