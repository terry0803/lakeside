data: {"type": "sections", "label": "Room", "title": {"en": "Banquet Door · Access Granted", "zh": "宴會廳門口・驗證通過"}, "subtitle": {"en": "Banquet Hall Door (open)", "zh": "宴會廳門口（打開）"}, "text": {"en": "Both factors check out and the door opens: authentication is done, and authorization now decides what you may do inside.", "zh": "兩種驗證都通過，門打開了：身分驗證完成，接著由授權決定你能做什麼。"}, "note": {"en": "Authentication proves who you are; authorization decides what you may access.", "zh": "驗證是確認你是誰，授權是決定你能用什麼。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "event_system", "en": "Event Registration & Check-in", "zh": "活動報名報到系統"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "mfa", "en": "Multi-Factor Authentication", "zh": "多因素驗證"}, {"key": "phish_resistant_mfa", "en": "Phishing-Resistant MFA", "zh": "防釣魚多因素驗證"}, {"key": "least_privilege", "en": "Least Privilege & Role-Based Access", "zh": "最小權限與角色權限"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_authentication", "en": "Authentication Factors", "zh": "驗證因素"}, {"key": "c_zero_trust", "en": "Zero Trust", "zh": "零信任"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "banquet", "en": "Banquet Hall · Events & CRM", "zh": "宴會廳・活動與 CRM", "base_en": "Banquet Hall", "base_zh": "宴會廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=11", "tour": "A"}, {"key": "play", "en": "Security Awareness Training Room", "zh": "資安訓練室", "base_en": "Training Room", "base_zh": "資安訓練室", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=7", "tour": "A"}]}]}

