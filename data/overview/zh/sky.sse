data: {"type": "sections", "label": "Room", "title": {"en": "Resort IT Map", "zh": "渡假村資訊系統地圖"}, "subtitle": {"en": "Hot-Air Balloon", "zh": "熱氣球"}, "text": {"en": "From the balloon you see the whole resort: every department runs on information systems, and they are all connected. Three landing routes: the clubhouse (main story), the old town (suppliers) and the lake (remote work, IoT and the SOC).", "zh": "從熱氣球上看整個渡假村：每個部門都靠資訊系統運作，系統之間彼此相連。三條降落路線：會館（主線）、老城（供應商）、湖上（行動辦公、物聯網、資安監控中心）。"}, "note": {"en": "People, processes, technology and data together make an information system.", "zh": "人、流程、科技、資料合起來才是資訊系統。"}, "badges": [], "sections": [{"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_cia", "en": "CIA Triad", "zh": "機密性、完整性、可用性（CIA）"}, {"key": "c_shared_responsibility", "en": "Shared Responsibility (Cloud & SaaS)", "zh": "共同責任（雲端與 SaaS）"}, {"key": "c_information_system", "en": "Information System", "zh": "資訊系統"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "patio", "en": "Guest Arrival & Wi-Fi", "zh": "客人報到與無線網路", "base_en": "Lakeside Patio", "base_zh": "湖畔露台", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=2", "tour": "A"}, {"key": "town_square", "en": "Harbour Square · Suppliers", "zh": "港口廣場・供應商", "base_en": "Harbour Square", "base_zh": "港口廣場", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=1", "tour": "B"}, {"key": "boat_deck", "en": "Steamer Deck · Working on the Move", "zh": "蒸汽船甲板・行動辦公", "base_en": "Steamer Deck", "base_zh": "蒸汽船甲板", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=8", "tour": "B"}]}]}

