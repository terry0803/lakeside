data: {"type": "sections", "label": "Room", "title": {"en": "Security Awareness Training Room", "zh": "資安訓練室"}, "subtitle": {"en": "Training Room", "zh": "資安訓練室"}, "text": {"en": "Staff learn to spot phishing, use strong passwords and MFA, and report anything strange.", "zh": "員工在這裡學會認出釣魚信、用好密碼和多因素驗證、看到怪事就回報。"}, "note": {"en": "People are part of security: training and phishing drills mean fewer wrong clicks.", "zh": "人也是資安的一環：訓練和演練能讓人少點錯。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "lms", "en": "Security Awareness Platform", "zh": "資安教育訓練平台"}, {"key": "email", "en": "Email & Collaboration", "zh": "電子郵件與協作平台"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "usb_malware", "en": "Malware from USB Drives", "zh": "USB 惡意程式"}, {"key": "phishing", "en": "Phishing Email", "zh": "釣魚郵件"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "awareness_training", "en": "Security Awareness Training", "zh": "資安意識訓練"}, {"key": "password_policy", "en": "Strong Password Policy", "zh": "密碼政策"}, {"key": "email_filtering", "en": "Email Security Filtering", "zh": "郵件安全過濾"}, {"key": "phish_simulation", "en": "Phishing Drills & Report Button", "zh": "釣魚演練與回報按鈕"}, {"key": "mfa", "en": "Multi-Factor Authentication", "zh": "多因素驗證"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_social_engineering", "en": "Social Engineering", "zh": "社交工程"}, {"key": "c_authentication", "en": "Authentication Factors", "zh": "驗證因素"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_phish_clicked", "en": "Clicked a phishing link or entered a password", "zh": "點了釣魚連結或輸入了密碼"}, {"key": "proc_usb_found", "en": "Found an unknown USB drive", "zh": "撿到來路不明的 USB"}, {"key": "proc_unexpected_mfa", "en": "MFA prompts I did not start", "zh": "收到不是自己發起的多因素驗證通知"}, {"key": "proc_phish_report", "en": "Received a suspicious email", "zh": "收到可疑郵件"}]}, {