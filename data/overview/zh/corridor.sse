data: {"type": "sections", "label": "Room", "title": {"en": "Staff Corridor & Physical Security", "zh": "員工走廊與實體安全"}, "subtitle": {"en": "Corridor", "zh": "走廊"}, "text": {"en": "Badge readers, CCTV and the visitor log guard the staff-only area; the policy board here holds the clues for both locked doors: passphrase length and screen-lock minutes for the banquet hall's MFA door, and the SOC's extension, which also opens the staff gate to the Lake Pavilion.", "zh": "門禁讀卡機、監視器和訪客登記守著員工區；這裡的政策公告是兩道鎖的線索：密語長度和螢幕鎖定的分鐘數開宴會廳的多因素驗證門，資安監控中心的分機也能開往湖心館的員工通道。"}, "note": {"en": "Don't let anyone follow you through a badge door, and escort visitors.", "zh": "刷卡門不要讓人跟著進來，訪客要有人陪同。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "cctv", "en": "CCTV & Video Management", "zh": "監視器與錄影系統"}, {"key": "access_control", "en": "Badge Access Control", "zh": "門禁系統"}, {"key": "visitor_mgmt", "en": "Visitor Management", "zh": "訪客登記系統"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "tailgating", "en": "Tailgating & Unauthorised Entry", "zh": "尾隨與未經授權進入"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "physical_access", "en": "Physical Access Control", "zh": "實體門禁"}, {"key": "cctv_monitoring", "en": "CCTV Monitoring", "zh": "監視器監控"}, {"key": "password_policy", "en": "Strong Password Policy", "zh": "密碼政策"}, {"key": "visitor_control", "en": "Visitor Registration & Escort", "zh": "訪客登記與陪同"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_lost_badge", "en": "Lost staff badge", "zh": "員工證遺失"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "corridor_near", "en": "Corridor Far End · Server Room Entrance", "zh": "走廊盡頭・機房入口", "base_en": "Corridor · Far End", "base_zh": "走廊盡頭", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=30", "tour": "A"}, {"key": "bar", "en": "Bar Inventory & ERP", "zh": "酒吧庫存與 ERP", "base_en": "Bar", "base_zh": "酒吧", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=4", "tour": "A"}, {"key": "billiard", "en": "IT Help Desk", "zh": "資訊服務台", "base_en": "IT Help Desk", "base_zh": "資訊服務台", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=6", "tour": "A"}, {"key": "cellar", "en": "Server Room (Restricted)", "zh": "機房（限制進入）", "base_en": "Server Room", "base_zh": "機房", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=17", "tour": "A"}]}]}

