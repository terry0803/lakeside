data: {"type": "sections", "label": "Room", "title": {"en": "Banquet Door · Failed Login", "zh": "宴會廳門口・驗證失敗"}, "subtitle": {"en": "Banquet Hall Door (wrong code)", "zh": "宴會廳門口（密碼錯誤）"}, "text": {"en": "A wrong code is rejected and logged; repeated failures would lock the account and alert the SOC.", "zh": "輸錯被拒絕，也被記錄；連續失敗會鎖帳號並通知資安監控中心。"}, "note": {"en": "Failed logins are a warning sign to watch, not just a nuisance.", "zh": "登入失敗是要注意的警訊。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "event_system", "en": "Event Registration & Check-in", "zh": "活動報名報到系統"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "mfa_fatigue", "en": "MFA Fatigue (Push Bombing)", "zh": "多因素驗證疲勞攻擊"}, {"key": "credential_stuffing", "en": "Password Guessing & Credential Stuffing", "zh": "密碼猜測與撞庫"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "mfa", "en": "Multi-Factor Authentication", "zh": "多因素驗證"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_authentication", "en": "Authentication Factors", "zh": "驗證因素"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_unexpected_mfa", "en": "MFA prompts I did not start", "zh": "收到不是自己發起的多因素驗證通知"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "play", "en": "Security Awareness Training Room", "zh": "資安訓練室", "base_en": "Training Room", "base_zh": "資安訓練室", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=7", "tour": "A"}]}]}

