data: {"type": "sections", "label": "Room", "title": {"en": "Help Desk Close-up · Ticket Board", "zh": "服務台近看・工單看板"}, "subtitle": {"en": "IT Help Desk · Up Close", "zh": "服務台近看"}, "text": {"en": "The ticket board shows open requests: new accounts, access changes and password resets.", "zh": "工單看板列出待處理的申請：開帳號、改權限、重設密碼。"}, "note": {"en": "Give each role the minimum access it needs.", "zh": "每個職務只給它需要的最少權限。"}, "badges": [{"en": "Weaknesses to find here: 1", "zh": "這裡藏著 1 個漏洞"}], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "itsm", "en": "IT Service Desk (ITSM)", "zh": "IT 服務台系統（ITSM）"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "vishing", "en": "Phone Social Engineering", "zh": "電話社交工程"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "caller_verification", "en": "Caller Identity Verification", "zh": "來電身分核實"}, {"key": "least_privilege", "en": "Least Privilege & Role-Based Access", "zh": "最小權限與角色權限"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_social_engineering", "en": "Social Engineering", "zh": "社交工程"}, {"key": "c_itsm", "en": "ITIL & IT Service Management", "zh": "ITIL 與 IT 服務管理"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_new_hire", "en": "New employee needs access", "zh": "新進人員開帳號"}, {"key": "proc_password_reset", "en": "Password or MFA reset", "zh": "密碼或驗證重設"}]}, {"h_en": "Real cases", "h_zh": "真實案例", "kind": "entities", "items": [{"key": "case_mgm", "en": "MGM Resorts Cyberattack (2023)", "zh": "MGM 渡假村網路攻擊（2023）"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "billiard", "en": "IT Help Desk", "zh": "資訊服務台", "base_en": "IT Help Desk", "base_zh": "資訊服務台", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=6", "tour": "A"}]}]}

