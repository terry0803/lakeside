data: {"type": "sections", "label": "Room", "title": {"en": "Pier · Deliveries & Vendors", "zh": "會館碼頭・進貨與廠商"}, "subtitle": {"en": "Clubhouse Pier", "zh": "會館碼頭"}, "text": {"en": "Suppliers deliver by boat; vendors also deliver software, support and remote access.", "zh": "供應商從碼頭送貨；廠商也提供軟體、維護和遠端連線。"}, "note": {"en": "Assess vendors before trusting them, and confirm any change to their bank details by phone.", "zh": "廠商要先評估；對方說要換匯款帳戶，一定打電話確認。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "supplier_portal", "en": "Supplier Portal", "zh": "供應商入口網站"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "bec", "en": "Business Email Compromise", "zh": "商務郵件詐騙"}, {"key": "supply_chain", "en": "Third-Party & Supply-Chain Compromise", "zh": "第三方與供應鏈入侵"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "vendor_remote_access", "en": "Time-Limited Vendor Access", "zh": "廠商限時遠端存取"}, {"key": "payment_callback", "en": "Payment Change Call-Back", "zh": "匯款變更回撥確認"}, {"key": "vendor_management", "en": "Vendor Risk Management", "zh": "廠商風險管理"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_erp", "en": "Enterprise Resource Planning (ERP)", "zh": "企業資源規劃（ERP）"}, {"key": "c_supply_chain_risk", "en": "Supply-Chain Risk", "zh": "供應鏈風險"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_vendor_access", "en": "A vendor needs remote access", "zh": "廠商要遠端連線"}, {"key": "proc_bank_change", "en": "A supplier asks to change their bank details", "zh": "供應商要求變更匯款帳戶"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "lawn", "en": "Lawn · Assembly Point & Continuity", "zh": "湖邊草地・集合點與營運持續", "base_en": "Lakeside Lawn", "base_zh": "湖邊草地", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=19", "tour": "A"}, {"key": "patio", "en": "Guest Arrival & Wi-Fi", "zh": "客人報到與無線網路", "base_en": "Lakeside Patio", "base_zh": "湖畔露台", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=2", "tour": "A"}, {"key": "rowboat", "en": "On the Lake · Offsite Backup", "zh": "湖面上的小船・異地備份", "base_en": "On the Lake", "base_zh": "湖面上的小船", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=10", "tour": "B"}, {"key": "boat_deck", "en": "Steamer Deck · Working on the Move", "zh": "蒸汽船甲板・行動辦公", "base_en": "Steamer Deck", "base_zh": "蒸汽船甲板", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=8", "tour": "B"}, {"key": "pool", "en": "Pool · Data Lake", "zh": "泳池・資料湖", "base_en": "Pool", "base_zh": "泳池", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=14", "tour": "B"}]}]}

