data: {"type": "sections", "label": "Room", "title": {"en": "Restaurant POS", "zh": "餐廳收銀系統"}, "subtitle": {"en": "Restaurant", "zh": "餐廳"}, "text": {"en": "Orders go from the POS to the kitchen display and cards are paid on encrypted terminals; card data is the most tightly regulated data here.", "zh": "點餐從 POS 送到廚房螢幕，用加密的刷卡機付款；信用卡資料是這裡管得最嚴的資料。"}, "note": {"en": "Never store the CVV or PIN, mask card numbers, and treat unexpected emails on the POS PC with suspicion.", "zh": "不能存安全碼和 PIN，卡號要遮罩；收銀電腦上收到奇怪的信先別點。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "pos", "en": "Point of Sale (POS)", "zh": "餐飲收銀系統（POS）"}, {"key": "pin_pad", "en": "Card Payment Terminal", "zh": "刷卡機"}, {"key": "email", "en": "Email & Collaboration", "zh": "電子郵件與協作平台"}, {"key": "endpoints", "en": "Staff Laptops, PCs & Phones", "zh": "員工筆電、電腦與手機"}, {"key": "kds", "en": "Kitchen Display System", "zh": "廚房出單系統"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "phishing", "en": "Phishing Email", "zh": "釣魚郵件"}, {"key": "pos_malware", "en": "POS Memory-Scraping Malware", "zh": "POS 記憶體側錄惡意程式"}, {"key": "skimming", "en": "Card Skimming & Terminal Tampering", "zh": "刷卡機側錄與竄改"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "p2pe_tokenization", "en": "P2PE & Tokenization", "zh": "點對點加密與代碼化"}, {"key": "no_sad_storage", "en": "Never Store CVV or PIN", "zh": "不儲存安全碼與 PIN"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_encryption_hashing", "en": "Encryption vs Hashing", "zh": "加密與雜湊"}, {"key": "c_pci_scope", "en": "Cardholder Data Environment (PCI scope)", "zh": "持卡人資料環境（PCI 範圍）"}, {"key": "c_tokenization", "en": "Tokenization", "zh": "代碼化"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_phish_report", "en": "Received a suspicious email", "zh": "收到可疑郵件"}, {"key": "proc_phish_clicked", "en": "Clicked a phishing link or entered a password", "zh": "點了釣魚連結或輸入了密碼"}, {"key": "proc_card_terminal", "en": "A card terminal looks tampered with", "zh": "刷卡機疑似被動過"}, {"key": "proc_pos_outage", "en": "The POS is down", "zh": "收銀系統當機"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "hall_fire", "en": "Fireplace Close-up · Ordering Tablet", "zh": "壁爐近看・點餐平板", "base_en": "Fireplace · Up Close", "base_zh": "壁爐近看", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=23", "tour": "A"}, {"key": "bar", "en": "Bar Inventory & ERP", "zh": "酒吧庫存與 ERP", "base_en": "Bar", "base_zh": "酒吧", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=4", "tour": "A"}, {"key": "hall_near", "en": "Restaurant Close-up · POS Terminal", "zh": "餐廳近看・收銀機", "base_en": "Restaurant · Up Close", "base_zh": "餐廳近看", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=22", "tour": "A"}, {"key": "hallnight", "en": "Restaurant at Night · POS Down", "zh": "夜晚的餐廳・收銀系統停擺", "base_en": "Restaurant at Night", "base_zh": "夜晚的餐廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=18", "tour": "A"}, {"key": "patio", "en": "Guest Arrival & Wi-Fi", "zh": "客人報到與無線網路", "base_en": "Lakeside Patio", "base_zh": "湖畔露台", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=2", "tour": "A"}]}]}

