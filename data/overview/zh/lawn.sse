data: {"type": "sections", "label": "Room", "title": {"en": "Lawn · Assembly Point & Continuity", "zh": "湖邊草地・集合點與營運持續"}, "subtitle": {"en": "Lakeside Lawn", "zh": "湖邊草地"}, "text": {"en": "The emergency assembly point; the business continuity plan says how the resort keeps running when systems or power fail.", "zh": "緊急集合點；營運持續計畫寫著系統或電力出問題時渡假村怎麼繼續營運。"}, "note": {"en": "Know the manual fallback for your job before you need it.", "zh": "事先知道自己的工作在系統掛掉時怎麼用人工替代。"}, "badges": [], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "power", "en": "UPS & Backup Generator", "zh": "不斷電系統與發電機"}]}, {"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "environmental", "en": "Power Outage, Fire & Flood", "zh": "停電、火災與淹水"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "bcp_dr", "en": "Business Continuity & Disaster Recovery", "zh": "營運持續與災難復原"}, {"key": "environmental_protection", "en": "UPS, Generator & Fire Suppression", "zh": "不斷電、發電機與滅火設備"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_bcp", "en": "BCP, RTO & RPO", "zh": "營運持續、RTO 與 RPO"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_pos_outage", "en": "The POS is down", "zh": "收銀系統當機"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "sky", "en": "Resort IT Map", "zh": "渡假村資訊系統地圖", "base_en": "Hot-Air Balloon", "base_zh": "熱氣球", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=1", "tour": "A"}, {"key": "pier", "en": "Pier · Deliveries & Vendors", "zh": "會館碼頭・進貨與廠商", "base_en": "Clubhouse Pier", "base_zh": "會館碼頭", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=20", "tour": "A"}, {"key": "pool", "en": "Pool · Data Lake", "zh": "泳池・資料湖", "base_en": "Pool", "base_zh": "泳池", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=14", "tour": "B"}, {"key": "patio", 