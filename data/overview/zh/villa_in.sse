data: {"type": "sections", "label": "Room", "title": {"en": "Villa Suite · Guest Privacy", "zh": "湖畔別墅套房・客人隱私"}, "subtitle": {"en": "Lake Villa Suite", "zh": "湖畔別墅套房"}, "text": {"en": "Inside the suite, the smart TV, voice controls and key card show how much guest data one room holds.", "zh": "套房裡的智慧電視、語音控制和房卡，看得出一間客房存了多少客人資料。"}, "note": {"en": "Reset every device at checkout so the next guest never sees the last one's data.", "zh": "退房時把每台裝置重設，下一位客人才不會看到前一位的資料。"}, "badges": [{"en": "Weaknesses to find here: 1", "zh": "這裡有 1 個漏洞待找"}], "sections": [{"h_en": "Systems", "h_zh": "系統", "kind": "entities", "items": [{"key": "room_controls", "en": "Smart Room Controls & TV", "zh": "客房智慧控制與電視"}, {"key": "door_locks", "en": "Electronic Door Locks", "zh": "電子門鎖系統"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "checkout_reset", "en": "Checkout Privacy Reset", "zh": "退房隱私重設"}, {"key": "retention_deletion", "en": "Data Minimization & Retention Schedule", "zh": "資料最小化與保存期限"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_checkout_reset", "en": "Smart room reset at checkout", "zh": "退房時重設智慧客房"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "pool", "en": "Pool · Data Lake", "zh": "泳池・資料湖", "base_en": "Pool", "base_zh": "泳池", "url": "https://livetour.istaging.com/335dad66-2cf9-43fc-a1dc-a9af776c16e2?index=14", "tour": "B"}]}]}

