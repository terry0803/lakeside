data: {"type": "sections", "label": "Room", "title": {"en": "Restaurant at Night · POS Down", "zh": "夜晚的餐廳・收銀系統停擺"}, "subtitle": {"en": "Restaurant at Night", "zh": "夜晚的餐廳"}, "text": {"en": "Someone clicked a phishing link on the POS PC; ransomware encrypted the systems and the restaurant cannot take orders (bad ending).", "zh": "有人在收銀電腦點了釣魚連結，勒索軟體把系統加密，餐廳沒辦法點餐（壞結局）。"}, "note": {"en": "Offline backups, segmentation and a practised response plan decide how fast you recover.", "zh": "離線備份、網段隔離和演練過的應變計畫，決定多快能恢復。"}, "badges": [], "sections": [{"h_en": "Threats", "h_zh": "威脅", "kind": "entities", "items": [{"key": "phishing", "en": "Phishing Email", "zh": "釣魚郵件"}, {"key": "ransomware", "en": "Ransomware", "zh": "勒索軟體"}]}, {"h_en": "Controls", "h_zh": "防護措施", "kind": "entities", "items": [{"key": "bcp_dr", "en": "Business Continuity & Disaster Recovery", "zh": "營運持續與災難復原"}, {"key": "backup_321", "en": "3-2-1 Backups with an Offline Copy", "zh": "3-2-1 備份與離線副本"}, {"key": "incident_response", "en": "Incident Response Plan & SOC", "zh": "事件應變計畫與資安監控中心"}]}, {"h_en": "Concepts", "h_zh": "概念", "kind": "entities", "items": [{"key": "c_bcp", "en": "BCP, RTO & RPO", "zh": "營運持續、RTO 與 RPO"}]}, {"h_en": "Procedures", "h_zh": "處理流程", "kind": "entities", "items": [{"key": "proc_ransomware", "en": "Ransomware or encrypted files", "zh": "勒索軟體或檔案被加密"}, {"key": "proc_phish_clicked", "en": "Clicked a phishing link or entered a password", "zh": "點了釣魚連結或輸入了密碼"}, {"key": "proc_pos_outage", "en": "The POS is down", "zh": "收銀系統當機"}]}, {"h_en": "Exits", "h_zh": "出口", "kind": "rooms", "items": [{"key": "hall", "en": "Restaurant POS", "zh": "餐廳收銀系統", "base_en": "Restaurant", "base_zh": "餐廳", "url": "https://livetour.istaging.com/6a1e0bab-b805-4788-935b-97a06a024613?index=3", "tour": "A"}]}]}

